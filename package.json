{
  "name": "cipherwave",
  "version": "2.0.0",
  "description": "Decentralized, anonymous, peer-to-peer messenger with E2E encryption and distributed signaling",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite --config src/client/vite.config.ts",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc --project tsconfig.server.json",
    "build:client": "vite build --config src/client/vite.config.ts",
    "start": "tsx src/server/index.ts",
    "start:node": "tsx src/server/node-host.ts",
    "lint": "biome check src/",
    "lint:fix": "biome check --fix src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "tsx scripts/migrate.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "webrtc",
    "p2p",
    "messaging",
    "encryption",
    "decentralized",
    "anonymous",
    "signal-protocol",
    "distributed"
  ],
  "author": "CipherWave Team",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^10.0.0",
    "@fontsource/chakra-petch": "^5.2.7",
    "@fontsource/space-mono": "^5.2.9",
    "@lucide/svelte": "^1.21.0",
    "@trystero-p2p/mqtt": "^0.25.2",
    "@trystero-p2p/torrent": "^0.25.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.3",
    "mqtt": "^5.15.1",
    "pino": "^9.9.2",
    "pino-pretty": "^13.1.2",
    "qrcode-generator": "^2.0.4",
    "sodium-native": "^4.3.3",
    "svelte-transition": "^0.0.17",
    "trystero": "^0.25.2",
    "ws": "^8.18.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@playwright/test": "^1.61.1",
    "@sveltejs/adapter-node": "^5.2.12",
    "@sveltejs/kit": "^2.21.2",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.3.1",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^3.2.6",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.0",
    "supertest": "^7.1.4",
    "svelte": "^5.28.2",
    "svelte-check": "^4.2.5",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/raccoon-warez/cipherwave"
  },
  "bugs": {
    "url": "https://github.com/raccoon-warez/cipherwave/issues"
  },
  "homepage": "https://github.com/raccoon-warez/cipherwave#readme"
}
