# CipherWave Configuration
PORT=8080
HOST=0.0.0.0
NODE_ID=cipherwave-node-1
NODE_TOKEN=your-secret-node-token

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CLUSTER=false

# Server
MAX_ROOM_SIZE=2
MAX_MESSAGE_SIZE=65536
ROOM_TTL_MINUTES=60
HEARTBEAT_INTERVAL=30000
CONNECTION_TIMEOUT=60000

# Security
TLS_ENABLED=false
TLS_CERT_PATH=
TLS_KEY_PATH=

# Metrics
METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_PATH=/metrics

# Environment
NODE_ENV=development
